# Neon PostgreSQL - configure DATABASE_URL nas variáveis secretas da hospedagem
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/brasvegas?sslmode=require

# Segurança obrigatória
JWT_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
ADMIN_API_TOKEN=DEFINA_UM_TOKEN_ADMINISTRATIVO_FORTE
APOSTAS_REAIS_HABILITADAS=false
CORS_ORIGINS=https://SEU-DOMINIO
DB_POOL_MAX=10

# Sicoob Pix - habilitação pela cooperativa e credenciais mTLS obrigatórias
SICOOB_AUTH_URL=https://apis.sisbr.com.br/cooperado/pix/token
SICOOB_API_URL=https://apis.sisbr.com.br/cooperado/pix/api/v2
SICOOB_CLIENT_ID=
SICOOB_CLIENT_SECRET=
SICOOB_SCOPE=cob.write cob.read
SICOOB_PIX_KEY=
SICOOB_CERT_PATH=/etc/secrets/sicoob-cert.pem
SICOOB_KEY_PATH=/etc/secrets/sicoob-key.pem

# Tempo padrão de cada rodada compartilhada (mínimo 15 segundos)
DURACAO_RODADA_SEGUNDOS=30
