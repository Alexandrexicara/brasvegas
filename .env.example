# Neon PostgreSQL - use a URL privada nas variáveis do serviço de hospedagem
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/brasvegas?sslmode=require

# Segurança obrigatória
JWT_SECRET=COLOQUE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
ADMIN_API_TOKEN=DEFINA_UM_TOKEN_ADMINISTRATIVO_FORTE

# Apostas reais permanecem BLOQUEADAS até aprovação jurídica e liberação bancária formal
APOSTAS_REAIS_HABILITADAS=false

# CORS: informe origens exatas separadas por vírgula
CORS_ORIGINS=https://SEU-DOMINIO

# Sicoob (preencher somente após habilitação oficial da API Pix e credenciais mTLS)
SICOOB_BASE_URL=
SICOOB_CLIENT_ID=
SICOOB_CLIENT_SECRET=
SICOOB_CERT_PATH=
SICOOB_KEY_PATH=
SICOOB_PIX_WEBHOOK_SECRET=
